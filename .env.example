# Client OAuth Google (#7). Les DEUX ou AUCUNE : sans elles, l'application
# démarre normalement et seul le chemin adresse/mot de passe existe.
#
# Elles se créent dans la console Google Cloud (« ID client OAuth », type
# « Application Web »). Les URI de redirection à y déclarer :
#   https://typing.tiarkaerell.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
#
# En local :  set -a; . ./.env; set +a; npm run server:dev
# En production : posées dans Coolify, jamais dans le dépôt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
