#!/bin/sh
# Un push sur `main` ne déploie PAS : il n'y a pas de webhook (Coolify est sur
# le LAN). Le déploiement se déclenche à la main par `npm run deploy`.
# Il n'y a donc pas de CI pour rattraper une erreur après coup — le filet est
# ici, avant l'envoi. Activation (une fois par clone) :
#
#   git config core.hooksPath .githooks
#
# Contournement en cas d'urgence : git push --no-verify
set -e

branche=$(git rev-parse --abbrev-ref HEAD)
if [ "$branche" != "main" ]; then
  echo "pre-push : branche $branche, pas de vérification (seul main déploie)."
  exit 0
fi

echo "pre-push : types, tests, e2e — un push sur main part en production."
npx tsc --noEmit
npx vitest run
# La connexion est obligatoire : plus aucun parcours n'atteint la leçon sans
# compte, donc les tests serveur ET la suite e2e exigent un Postgres.
npm run test:db
npx playwright test
echo "pre-push : tout est vert, envoi."
